[Unit]
Description=Chessil GitHub deploy webhook (%i)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/chessil.com/deploy-hook
Environment=PORT=%i
EnvironmentFile=/etc/chessil/deploy-hook.env
ExecStart=/usr/bin/node /home/ubuntu/chessil.com/deploy-hook/server.js
Restart=always
RestartSec=1
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=10
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
