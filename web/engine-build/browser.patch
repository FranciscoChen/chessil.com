diff --git a/src/emscripten/extern-post.js b/src/emscripten/extern-post.js
index 440a239..450d365 100644
--- a/src/emscripten/extern-post.js
+++ b/src/emscripten/extern-post.js
@@ -574,7 +574,18 @@ if (isPthreadWorker) {
                     onmessage = function (event)
                     {
                         /// For backwards compatibility, the engine can inform the frontend of the ability to output download progress.
-                        if (event.data === "setoption name CanOutputEngineDownloadProgress") {
+                        if (event.data && event.data.type === "loadNetwork") {
+                            if (!engine.processCommand || engine._isSearching()) { postMessage("networkerror busy"); return; }
+                            try {
+                                var name = event.data.name;
+                                if (!/^[a-zA-Z0-9_.-]+$/.test(name)) throw new Error("Invalid network filename");
+                                engine.FS.writeFile("/" + name, new Uint8Array(event.data.data));
+                                var option = event.data.option || "EvalFile";
+                                if (!/^[A-Za-z][A-Za-z0-9 _-]{0,63}$/.test(option)) throw new Error("Invalid network option");
+                                engine.processCommand("setoption name " + option + " value /" + name);
+                                postMessage("networkready");
+                            } catch (error) { postMessage("networkerror " + error.message); }
+                        } else if (event.data === "setoption name CanOutputEngineDownloadProgress") {
                             postMessage("info WillOutputEngineDownloadProgress");
                         } else if (event.data.progressPort) {
                             progressPort = event.data.progressPort;
diff --git a/src/emscripten/wasm-makefile.mk b/src/emscripten/wasm-makefile.mk
index cd9103f..b7fcf03 100644
--- a/src/emscripten/wasm-makefile.mk
+++ b/src/emscripten/wasm-makefile.mk
@@ -14,6 +14,15 @@ ifeq ($(ASMJS),yes)
 	sse2 = no
 	ssse3 = no
 	sse41 = no
+else ifeq ($(WASM_SIMD),no)
+	# Portable fallback: no SIMD intrinsics or auto-vectorized instructions.
+	EM_CXXFLAGS += -mno-simd128 -fno-vectorize -fno-slp-vectorize
+	EM_LDFLAGS += -mno-simd128 -sMIN_SAFARI_VERSION=150000
+	popcnt = no
+	sse = no
+	sse2 = no
+	ssse3 = no
+	sse41 = no
 else
 	EM_CXXFLAGS += -msimd128
 	# CPU settings
@@ -83,7 +92,7 @@ EM_LDFLAGS  += -s EXPORT_NAME="Stockfish"
 #EM_LDFLAGS  += -s NO_FILESYSTEM=1
 #EM_LDFLAGS  += -s EXPORTED_FUNCTIONS="['_main','_command']"
 
-EM_LDFLAGS  += -s EXPORTED_RUNTIME_METHODS=ccall
+EM_LDFLAGS  += -s EXPORTED_RUNTIME_METHODS=ccall,FS
